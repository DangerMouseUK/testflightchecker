# Copy to .env and replace the fictional invitation with your public TestFlight link.
# Never commit .env or real credentials. Leave every field in an unused channel blank.
INVITE_URLS=https://testflight.apple.com/join/ABCDEFGH
POLL_INTERVAL_MS=60000
POLL_JITTER_PERCENTAGE=10
PORT=8080
NODE_ENV=development

# Optional email channel: fill in all three values to enable it.
# Use a Resend-authorised sender, for example sender@example.com.
# Multiple recipients may be comma-separated, for example recipient@example.com.
RESEND_API_KEY=
ALERT_SENDER=
ALERT_RECIPIENT=

# Optional Telegram channel: fill in both values to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
